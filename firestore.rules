rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.yksField in ['Sayısal', 'Eşit Ağırlık', 'Sözel', 'Dil'];
    }

    function isValidTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category in ['task', 'event', 'todo'] &&
             data.completed is bool &&
             data.date is string && data.date.size() <= 20;
    }

    function isValidDeneme(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.type in ['TYT', 'AYT'] &&
             data.date is string && data.date.size() <= 20 &&
             data.totalNet is number;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && 
                       incoming().uid == request.auth.uid &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && 
                       incoming().uid == existing().uid &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) &&
                         incoming().ownerId == request.auth.uid &&
                         isValidTask(incoming());
        allow update: if isOwner(userId) && isValidId(taskId) &&
                         incoming().ownerId == existing().ownerId &&
                         isValidTask(incoming());
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Denemeler subcollection
      match /denemeler/{denemeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(denemeId) &&
                         incoming().ownerId == request.auth.uid &&
                         isValidDeneme(incoming());
        allow update: if isOwner(userId) && isValidId(denemeId) &&
                         incoming().ownerId == existing().ownerId &&
                         isValidDeneme(incoming());
        allow delete: if isOwner(userId) && isValidId(denemeId);
      }
    }
  }
}
